# Copy to infra/ibgateway/.env and fill in. NEVER commit the filled file.
# These are IBKR account credentials; infra/.env and this file are gitignored
# for the same reason (ADR-0003).
TWS_USERID=
TWS_PASSWORD=
VNC_SERVER_PASSWORD=

# Paper only. Changing this to `live` is a real-money decision and is out of
# scope for the paper phase — see docs/00-vision.md and ADR-0003.
TRADING_MODE=paper
